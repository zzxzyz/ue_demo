{
    // 将特定路径下的 .txt 文件识别为 Lua
    "files.associations": {
        "**/Slua/Resources/**/*.txt": "lua",
        "**/Slua/**/*.txt": "lua"
    },
    
    // Lua 语言服务器配置（如果安装了 Lua 扩展）
    "[lua]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.formatOnSave": false,
        "editor.wordWrap": "on"
    },
    
    // 文件排除配置（可选）
    "files.exclude": {
        "**/.git": true,
        "**/.DS_Store": true,
        "**/Library": true,
        "**/Temp": true,
        "**/obj": true
    }
}

